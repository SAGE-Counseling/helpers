{
    "name": "sage-counseling/helpers",
    "description": "Shared helper package for SAGE Counseling sites",
    "type": "library",
    "license": "MIT",
    "keywords": ["sage-counseling", "helpers"],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^9.0 || ^10.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "vlucas/phpdotenv": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "SageCounseling\\Helpers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SageCounseling\\Helpers\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SageCounseling\\Helpers\\Laravel\\SageHelpersServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
